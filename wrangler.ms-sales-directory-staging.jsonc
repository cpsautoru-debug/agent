{
  "name": "autosklad63-ms-sales-directory-staging",
  "main": "workers/ms-sales-directory-sync.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "keep_vars": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "MS_PRODUCTION_DB",
      "database_name": "autosklad63-ms-production-staging",
      "database_id": "703b43bf-82a4-454b-89c7-cff7e7e8aab8"
    }
  ],
  "vars": {
    "MS_ASSORTMENT_SYNC": "enabled",
    "MS_ORDER_AUTO_SYNC": "enabled",
    "MS_SALES_DIRECTORY_SYNC": "enabled"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
