{
  // EXAMPLE ONLY. Not deployed. Do not enable until dedicated D1,
  // MS_API_TOKEN secret and a full owner-only staging smoke are confirmed.
  "name": "autosklad63-ms-production-autosync-staging",
  "main": "./workers/ms-production-autosync.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  // Set D1 binding ONLY in a local untracked config after creating a dedicated staging D1.
  // Required: d1_databases [{binding:'MS_PRODUCTION_DB',database_name:'autosklad63-ms-production-staging',database_id:'<uuid>'}].
  // Cloudflare encrypted Pages secrets cannot be read back or inherited by this Worker.
  "vars": { "MS_PRODUCTION_AUTO_SYNC": "disabled" }
}
