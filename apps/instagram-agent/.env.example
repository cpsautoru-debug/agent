# Copy to .env. Do not put tokens in chat or Git.
HOST=127.0.0.1
PORT=8766
# Optional: if empty, generated in data/admin-token.txt on first launch.
ADMIN_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Set to the version supported by your Meta application, e.g. vNN.N.
META_API_VERSION=
# Sending disabled by default. ALLOW_SEND=true permits manual approved sending.
ALLOW_SEND=false
# Auto mode sends only canned FAQ replies, never generated model drafts.
AUTO_REPLY=false
DAILY_SEND_LIMIT=30
# Optional LOCAL Ollama model name. Blank = FAQ and handoff only.
OLLAMA_MODEL=
